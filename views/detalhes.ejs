<%- include('partials/header') %>


<span class="badge bg-secondary"><%= servico.categoria %></span>

<h1><%= servico.nome %></h1>

<p><%= servico.descricao %></p>
<p class="preco">R$ <%= servico.preco.replace('.', ',') %> · <%= servico.duracao_min %> min</p>


<h2 class="h4 mt-4">Barbeiros que fazem este serviço</h2>

<ul class="list-group mb-4">

    <% barbeiros.forEach(barbeiro => { %>
        <li class="list-group-item">
            <%= barbeiro.username %>
        </li>
    <% }) %>

</ul>


<a href="/cliente/agendar/<%= servico.id %>" class="btn btn-dark">Agendar este serviço</a>
<a href="/" class="btn btn-outline-dark">Voltar</a>


<%- include('partials/footer') %>
<%- include('partials/header') %>


<div class="row justify-content-center">

    <div class="col-md-6">

        <h1><%= servico.nome %></h1>


        <p class="preco">R$ <%= servico.preco.replace('.', ',') %> · <%= servico.duracao_min %> min</p>


        <form action="<%= acao %>" method="POST">

            <div class="mb-3">
                <label for="barbeiro_id" class="form-label">Barbeiro</label>

                <select id="barbeiro_id" name="barbeiro_id" class="form-select" required>
                    <option value="">Escolha um barbeiro</option>
                    <% barbeiros.forEach(barbeiro => { %>
                        <option value="<%= barbeiro.id %>" <%= barbeiro.id === agendamento.barbeiro_id ? 'selected' : '' %>><%= barbeiro.username %></option>
                    <% }) %>
                </select>

            </div>

            <div class="mb-3">
                <label for="data" class="form-label">Data</label>
                <input type="date" id="data" name="data" class="form-control" min="<%= hoje %>" value="<%= agendamento.data %>" required>
            </div>

            <div class="mb-3">

                <label for="hora" class="form-label">Horário</label>

                <select id="hora" name="hora" class="form-select" required>
                    <option value="">Escolha um horário</option>
                    <% ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00'].forEach(hora => { %>
                        <option value="<%= hora %>" <%= hora + ':00' === agendamento.hora ? 'selected' : '' %>><%= hora %></option>
                    <% }) %>
                </select>

            </div>

            <button type="submit" class="btn btn-dark w-100">Confirmar</button>

        </form>


        <a href="/cliente" class="btn btn-outline-dark w-100 mt-2">Voltar</a>


    </div>

</div>


<%- include('partials/footer') %>